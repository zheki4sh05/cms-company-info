# Пример .env при запуске сервиса в Docker (БД и Kafka — снаружи контейнера).
# Скопируйте в .env и подставьте свои значения.

PORT=9092

# PostgreSQL на хосте (или в другом compose/кластере)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5433
POSTGRES_DB=company_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

AUTH_SERVICE_URL=http://host.docker.internal:9091

# Kafka на хосте или в отдельном кластере
KAFKA_BROKERS=host.docker.internal:9000
KAFKA_CLIENT_ID=cms-company-info
KAFKA_GROUP_ID=cms-company-info-group
KAFKA_COMPANY_TOPIC=company
KAFKA_AUTH_TOPIC=auth_topic

# JWT: в контейнере используйте JWT_PUBLIC_KEY или смонтируйте ключ в volume
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
